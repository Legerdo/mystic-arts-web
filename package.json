{
  "name": "mystic-arts-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Browser port of the original Mystic Arts (1998)",
  "scripts": {
    "setup": "npm ci --prefix phaser && npm ci --prefix phaser/native-core",
    "dev": "npm run build && npm run preview",
    "preview": "node tools/serve.mjs phaser/native-core/dist",
    "build": "node phaser/native-core/build.mjs --original-dir phaser/native-core/dist/original",
    "verify": "node tools/verify-native-dist.mjs",
    "test": "npm run verify",
    "test:browser": "python phaser/native-core/static-check.py",
    "test:oracle": "node phaser/native-core/check-hot.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
